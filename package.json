{
  "name": "perro-dinero",
  "version": "1.0.0",
  "description": "Perro Dinero - Finanzas Personales",
  "engines": {
    "node": ">=26.3.0"
  },
  "scripts": {
    "clean": "rimraf _site",
    "serve:webpack": "webpack --mode development --watch",
    "serve:eleventy": "eleventy --serve --incremental",
    "serve": "npm-run-all clean --parallel serve:*",
    "dev": "npm-run-all clean --parallel serve:*",
    "build:webpack": "webpack --mode production",
    "build:eleventy": "eleventy",
    "build": "run-s clean build:*",
    "debug": "DEBUG=* eleventy",
    "convert-gifs": "for i in img/posts/*.gif; do ffmpeg -i \"$i\" -b:v 0 -crf 25 -vcodec libx264 -pix_fmt yuv420p \"${i%.*}.mp4\" -y; ffmpeg -i \"$i\" -c vp9 -b:v 0 -crf 41 \"${i%.*}.webm\" -y; done",
    "update-portfolio": "./scripts/updatePortfolio.js",
    "verify:site": "node scripts/verify-site.js",
    "verify:ci": "node scripts/verify-ci.js",
    "verify:deps": "node scripts/verify-dependencies.js",
    "verify:eleventy": "node scripts/verify-eleventy-config.js",
    "verify:links": "node scripts/verify-links.js",
    "test:calculators": "node --test scripts/calculators/**/*.test.mjs",
    "verify:calculators": "npm run test:calculators",
    "verify": "npm run build && npm run verify:calculators && npm run verify:site && npm run verify:ci && npm run verify:deps && npm run verify:eleventy && npm run verify:links"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/davidojedalopez/perro-dinero.git"
  },
  "license": "MIT",
  "author": {
    "name": "David Ojeda",
    "email": "davidojeda@hey.com",
    "url": "https://davidojeda.dev"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-fetch": "^5.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@csstools/postcss-oklab-function": "^5.0.4",
    "@netlify/plugin-lighthouse": "^6.0.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "css-loader": "^7.1.4",
    "dotenv": "^17.4.2",
    "luxon": "^3.7.2",
    "markdown-it": "^14.2.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-toc-done-right": "^4.2.0",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.15",
    "postcss-loader": "^8.2.1",
    "rimraf": "^6.1.3",
    "rough-notation": "^0.5.1",
    "tailwindcss": "^4.3.0",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "workbox-webpack-plugin": "^7.4.1"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "tar-fs": "^2.1.4",
    "ws": "^8.21.0"
  }
}
